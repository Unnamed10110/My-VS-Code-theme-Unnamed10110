    "terminal.ansiBrightRed": "#ff6680",
    "terminal.ansiBrightGreen": "#6ee5a3",
    "terminal.ansiBrightYellow": "#ffc458",
    "terminal.ansiBrightBlue": "#a3b0ff",
    "terminal.ansiBrightMagenta": "#ff6ac1",
    "terminal.ansiBrightCyan": "#a0e6ee",
    "terminal.ansiBrightWhite": "#ffffff",
