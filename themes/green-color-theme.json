    "button.hoverBackground": "#26ff9a",
    "button.secondaryBackground": "#0b0b0b",
    "button.secondaryForeground": "#e8e8e8",
    "button.secondaryHoverBackground": "#00ff8833",
    "checkbox.background": "#000000",
    "checkbox.border": "#00ff8873",
    "checkbox.foreground": "#00ff88",
    "badge.background": "#00ff88",
    "badge.foreground": "#000000",
    "progressBar.background": "#00ff88",
    "notifications.background": "#0b0b0b",
    "notifications.border": "#00ff8873",
    "notificationCenterHeader.background": "#0b0b0b",
