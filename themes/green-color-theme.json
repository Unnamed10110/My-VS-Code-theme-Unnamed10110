    "statusBarItem.remoteForeground": "#000000",
    "input.background": "#000000",
    "input.foreground": "#e8e8e8",
    "input.border": "#00ff8873",
    "input.placeholderForeground": "#7a7a7a",
    "inputOption.activeBorder": "#00ff88",
    "inputOption.activeBackground": "#00ff8840",
    "inputValidation.errorBorder": "#ff3355",
    "inputValidation.errorBackground": "#0b0b0b",
    "dropdown.background": "#0b0b0b",
    "dropdown.border": "#00ff8873",
    "dropdown.foreground": "#e8e8e8",
    "button.background": "#00ff88",
